// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String  @id @default(cuid())
  telegramId BigInt  @unique
  username   String?
  firstName  String?
  lastName   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chatUsers ChatUser[]
}

model Chat {
  id         String  @id @default(cuid())
  telegramId BigInt  @unique
  title      String?

  createdAt DateTime @default(now())

  users  ChatUser[]
  rounds GameRound[]
}

model ChatUser {
  id String @id @default(cuid())

  userId String
  chatId String

  user User @relation(fields: [userId], references: [id])
  chat Chat @relation(fields: [chatId], references: [id])

  balance Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  bets         RoundBet[]

  @@unique([userId, chatId])
  @@index([chatId])
  @@index([userId])
}

model GameRound {
  id String @id @default(cuid())

  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id])

  status RoundStatus
  endsAt DateTime

  resultColor  RouletteColor?
  resultNumber Int?

  createdAt DateTime @default(now())

  bets RoundBet[]

  @@index([chatId, status])
  @@index([endsAt])
}

model RoundBet {
  id String @id @default(cuid())

  roundId String
  round   GameRound @relation(fields: [roundId], references: [id])

  chatUserId String
  chatUser   ChatUser @relation(fields: [chatUserId], references: [id])

  amount Int

  color  RouletteColor?
  number Int?

  createdAt DateTime @default(now())

  @@index([roundId])
  @@index([chatUserId])
}

model Transaction {
  id String @id @default(cuid())

  chatUserId String
  chatUser   ChatUser @relation(fields: [chatUserId], references: [id])

  amount Int // + / -
  type   TransactionType
  reason String?

  createdAt DateTime @default(now())

  @@index([chatUserId])
  @@index([createdAt])
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  BET
  WIN
  BONUS
}

enum RoundStatus {
  OPEN
  CLOSED
  RESOLVED
}

enum RouletteColor {
  RED
  BLACK
  GREEN
}
